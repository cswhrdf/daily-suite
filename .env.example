# ==========================================================
# daily-suite 环境变量模板
# 用法：复制为 .env 后按需填写（cp .env.example .env）
# 注意：本文件只允许占位符/空值，禁止写入真实密钥
# ==========================================================

# ---------- Django ----------
# 生成方式：python -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=
# 生产环境必须为 false
DJANGO_DEBUG=false
# 逗号分隔的主机名，例如：localhost,127.0.0.1,app.example.com
# 公网经 cloudflared / 内网经 Caddy 回源后，Host 头仍是应用域名（如 app.example.com），
# 因此启用 HTTPS 入口（Caddy / cloudflared）时必须把该域名列进来，否则 Django 返回 400 Bad Request。
DJANGO_ALLOWED_HOSTS=
# 逗号分隔的可信来源，例如：https://app.example.com,http://localhost:5173
# 注意：必须带 scheme（https:// 或 http://），只写域名会被 Django 忽略。
DJANGO_CSRF_TRUSTED_ORIGINS=
# 全站强制 HTTPS 跳转；本地开发如需 http 调试请保持 false。
# 依赖上游透传 X-Forwarded-Proto: https（Caddy / cloudflared 已满足），
# 开启后容器内健康探针也需带该头，否则会被 301 到 https 而探活失败。
DJANGO_SECURE_SSL_REDIRECT=false

# ---------- 公网访问与 HTTPS（profiles: tls / tunnel）----------
# 以下三项留空时，caddy / cloudflared 都处于默认未启动状态，不影响本地开发。
#
# Caddy 签发证书与 ALLOWED_HOSTS 用的应用域名（单域名，不要带 scheme 或路径）。
# 示例：app.example.com（该域名需已托管在 Cloudflare）
APP_DOMAIN=
# Cloudflare API Token，供 Caddy 走 DNS-01 签发/续期证书。
# 示例：在 CF 后台 My Profile -> API Tokens 创建自定义 Token，权限 Zone.DNS Edit，
#       Zone Resources 限定到该域名所在的单个 zone
CF_API_TOKEN=
# Cloudflare Tunnel 的 tunnel token，从 CF 后台 Zero Trust -> Networks -> Tunnels
# 的隧道详情页复制（形如 eyJ... 的长串），cloudflared 用它建立出站连接。
CF_TUNNEL_TOKEN=

# ---------- 认证 / JWT ----------
# Refresh Token 通过 httpOnly + Secure + SameSite=Lax Cookie 下发。
# 仅本地 http 联调（如 http://127.0.0.1:5173）需要显式关闭 Secure；
# 注释掉本项时，dev 配置按 DJANGO_DEBUG 自动推导（DEBUG=true 则为 false），
# 生产配置恒为 true，不受本变量影响。
# DJANGO_AUTH_COOKIE_SECURE=false

# ---------- PostgreSQL ----------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# ---------- Redis ----------
# 密码，生成方式同上（python -c 'import secrets; print(secrets.token_urlsafe(24))'）
REDIS_PASSWORD=
# 连接串，带密码形式：redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_URL=
